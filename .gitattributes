    <style>
        :root {
            --color-sand: #D8C9AE;
            --color-teal: #2A4B4C;
            --color-taupe: #8B7D6B;
        }

        body {
            background-color: var(--color-sand);
            color: var(--color-teal);
            font-family: 'Outfit', sans-serif;
            overflow-x: hidden;
        }

        .font-retro {
            font-family: 'Courier Prime', monospace;
        }

        /* Lo-Fi 雜訊效果 */
        .noise::before {
            content: "";
            position: fixed;
            top: 0; left: 0;
            width: 100vw; height: 100vh;
            opacity: 0.05;
            pointer-events: none;
            z-index: 9999;
            background-image: url('https://www.transparenttextures.com/patterns/stardust.png');
        }

        /* 黑膠旋轉動畫 */
        @keyframes rotate {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
        .vinyl-record {
            animation: rotate 8s linear infinite;
        }

        /* 捲軸美化 */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: var(--color-sand);
        }
        ::-webkit-scrollbar-thumb {
            background: var(--color-taupe);
        }

        .card-shadow {
            box-shadow: 8px 8px 0px var(--color-taupe);
        }
    </style>
<a href="https://chyshenn.github.io/term_project/" style="padding: 10px; background: #2d3748; color: white; border-radius: 5px; text-decoration: none;">
